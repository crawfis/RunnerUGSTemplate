# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/
/[Ss]creenshots/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo

# ...but NOT the Cloud Code C# modules. Those .sln/.csproj files are authored, not
# regenerated by Unity's project generation, so ignoring them leaves a fresh clone with a
# .ccmr pointing at a solution that does not exist - which is exactly what happens today.
!Assets/**/CloudCode/**/*.sln
!Assets/**/CloudCode/**/*.csproj
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

/ProjectSettings/ProjectVersion.txt
/ProjectSettings/ProjectSettings.asset

/ProjectSettings/Packages/com.unity.dedicated-server/MultiplayerRolesSettings.asset
/Assets/CloudCode/BlocksAdminModule~/Project/bin/Release/net6.0
/Assets/CloudCode/BlocksAdminModule~/Project/obj
/Assets/CloudCode/BlocksGameModule~/Project/bin/Release/net6.0
/Assets/CloudCode/BlocksGameModule~/Project/obj
/Assets/Scripts/UnityGamingServices/CloudCode/TempleRunUGSCloud~/Project/bin
/Assets/Scripts/UnityGamingServices/CloudCode/TempleRunUGSCloud~/Project/obj
/Assets/Asset Cleaner
/Assets/Sparrow
/Assets/Asset Cleaner.meta
/Assets/Sparrow.meta
/SerializedBuildInfo
/referencemap.xml
/Assets/UGS/CloudCode/TempleRunUGSCloud~/Project/bin
/Assets/UGS/CloudCode/TempleRunUGSCloud~/Project/obj
debug_event_log.txt

# Cloud Code module build output. The existing rules named one module's Project/ folder by
# hand and missed its TestProject, so a generated test project dropped ~100 DLLs into the
# untracked list. Cover every module, both projects, once.
Assets/**/CloudCode/**/bin/
Assets/**/CloudCode/**/obj/
